   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Machine Failure Survival Analysis\n",
    "\n",
    "This notebook performs survival analysis on machine failure data to predict Remaining Useful Life (RUL).\n",
    "\n",
    "## Methods:\n",
    "- Cox Proportional Hazards\n",
    "- Weibull Accelerated Failure Time\n",
    "- Random Forest baseline\n",
    "- Deep Survival Networks (optional)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Import libraries with error handling\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "from sklearn.ensemble import RandomForestRegressor\n",
    "from sklearn.metrics import mean_squared_error, mean_absolute_error\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "# Survival analysis libraries\n",
    "try:\n",
    "    from lifelines import WeibullAFTFitter, CoxPHFitter, KaplanMeierFitter\n",
    "    LIFELINES_AVAILABLE = True\n",
    "    print(\"✓ Lifelines available\")\n",
    "except ImportError:\n",
    "    LIFELINES_AVAILABLE = False\n",
    "    print(\"✗ Lifelines not available\")\n",
    "\n",
    "plt.style.use('seaborn-v0_8')\n",
    "print(\"Libraries imported successfully!\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Data loading functions\n",
    "def load_machine_data():\n",
    "    \"\"\"Load machine data with fallback options\"\"\"\n",
    "    \n",
    "    # Try CMAPSS dataset\n",
    "    try:\n",
    "        column_names = [\"unit_number\", \"time_in_cycles\"] + \\\n",
    "                       [f\"op_setting_{i}\" for i in range(1, 4)] + \\\n",
    "                       [f\"sensor_measurement_{i}\" for i in range(1, 22)]\n",
    "        df = pd.read_csv(\"train_FD001.txt\", sep=\"\\s+\", header=None, names=column_names)\n",
    "        print(f\"✓ Loaded CMAPSS data: {df.shape}\")\n",
    "        return df, \"CMAPSS\"\n",
    "    except FileNotFoundError:\n",
    "        pass\n",
    "    \n",
    "    # Try industrial dataset\n",
    "    try:\n",
    "        df = pd.read_csv(\"IndFD-PM-DT dataset.csv\")\n",
    "        print(f\"✓ Loaded industrial data: {df.shape}\")\n",
    "        return df, \"Industrial\"\n",
    "    except FileNotFoundError:\n",
    "        pass\n",
    "    \n",
    "    # Create sample data\n",
    "    print(\"Creating sample machine failure data...\")\n",
    "    np.random.seed(42)\n",
    "    \n",
    "    data = []\n",
    "    for machine_id in range(1, 101):\n",
    "        failure_cycle = np.random.randint(50, 200)\n",
    "        for cycle in range(1, failure_cycle + 1):\n",
    "            degradation = cycle / failure_cycle\n",
    "            data.append({\n",
    "                'unit_number': machine_id,\n",
    "                'time_in_cycles': cycle,\n",
    "                'sensor_measurement_2': 100 + degradation * 20 + np.random.normal(0, 2),\n",
    "                'sensor_measurement_3': 50 + degradation * 15 + np.random.normal(0, 1.5),\n",
    "                'sensor_measurement_7': 300 + degradation * 40 + np.random.normal(0, 5)\n",
    "            })\n",
    "    \n",
    "    df = pd.DataFrame(data)\n",
    "    print(f\"✓ Created sample data: {df.shape}\")\n",
    "    return df, \"Sample\"\n",
    "\n",
    "def compute_rul(df):\n",
    "    \"\"\"Compute Remaining Useful Life\"\"\"\n",
    "    def calc_rul(unit_df):\n",
    "        max_cycle = unit_df['time_in_cycles'].max()\n",
    "        unit_df = unit_df.copy()\n",
    "        unit_df['RUL'] = max_cycle - unit_df['time_in_cycles']\n",
    "        return unit_df\n",
    "    \n",
    "    return df.groupby('unit_number').apply(calc_rul).reset_index(drop=True)\n",
    "\n",
    "# Load and prepare data\n",
    "df_raw, data_source = load_machine_data()\n",
    "df_with_rul = compute_rul(df_raw)\n",
    "\n",
    "# Create survival dataset (last observation per unit)\n",
    "df_survival = df_with_rul.groupby('unit_number').last().reset_index()\n",
    "df_survival['duration'] = df_survival['time_in_cycles']\n",
    "df_survival['event_observed'] = 1  # All units eventually fail\n",
    "\n",
    "# Select sensor features\n",
    "sensor_cols = [col for col in df_survival.columns if 'sensor_measurement' in col]\n",
    "\n",
    "print(f\"\\nUsing {data_source} dataset\")\n",
    "print(f\"Survival dataset: {df_survival.shape}\")\n",
    "print(f\"Sensor features: {len(sensor_cols)}\")\n",
    "print(f\"Duration range: {df_survival['duration'].min()}-{df_survival['duration'].max()}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Data exploration\n",
    "fig, axes = plt.subplots(2, 2, figsize=(15, 10))\n",
    "\n",
    "# Duration distribution\n",
    "axes[0, 0].hist(df_survival['duration'], bins=20, alpha=0.7, edgecolor='black')\n",
    "axes[0, 0].set_title('Distribution of Failure Times')\n",
    "axes[0, 0].set_xlabel('Duration (cycles)')\n",
    "axes[0, 0].set_ylabel('Frequency')\n",
    "\n",
    "# Sensor correlation\n",
    "if len(sensor_cols) >= 2:\n",
    "    corr_data = df_survival[sensor_cols[:5] + ['duration']]\n",
    "    corr_matrix = corr_data.corr()\n",
    "    sns.heatmap(corr_matrix, annot=True, cmap='coolwarm', center=0, ax=axes[0, 1])\n",
    "    axes[0, 1].set_title('Sensor-Duration Correlations')\n",
    "\n",
    "# Sensor vs duration\n",
    "if sensor_cols:\n",
    "    axes[1, 0].scatter(df_survival[sensor_cols[0]], df_survival['duration'], alpha=0.6)\n",
    "    axes[1, 0].set_xlabel(sensor_cols[0])\n",
    "    axes[1, 0].set_ylabel('Duration')\n",
    "    axes[1, 0].set_title(f'{sensor_cols[0]} vs Duration')\n",
    "\n",
    "# Kaplan-Meier curve\n",
    "if LIFELINES_AVAILABLE:\n",
    "    kmf = KaplanMeierFitter()\n",
    "    kmf.fit(df_survival['duration'], event_observed=df_survival['event_observed'])\n",
    "    kmf.plot_survival_function(ax=axes[1, 1])\n",
    "    axes[1, 1].set_title('Kaplan-Meier Survival Curve')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "print(\"\\nData Summary:\")\n",
    "print(f\"Units: {len(df_survival)}\")\n",
    "print(f\"Mean duration: {df_survival['duration'].mean():.1f}\")\n",
    "print(f\"Event rate: {df_survival['event_observed'].mean():.2%}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Cox Proportional Hazards Model\n",
    "def fit_cox_model():\n",
    "    if not LIFELINES_AVAILABLE or not sensor_cols:\n",
    "        print(\"Cox model not available\")\n",
    "        return None\n",
    "    \n",
    "    print(\"=\" * 50)\n",
    "    print(\"COX PROPORTIONAL HAZARDS MODEL\")\n",
    "    print(\"=\" * 50)\n",
    "    \n",
    "    # Select top sensors by correlation\n",
    "    correlations = df_survival[sensor_cols].corrwith(df_survival['duration']).abs()\n",
    "    top_sensors = correlations.nlargest(min(3, len(sensor_cols))).index.tolist()\n",
    "    \n",
    "    # Prepare data\n",
    "    cox_data = df_survival[top_sensors + ['duration', 'event_observed']].copy().dropna()\n",
    "    \n",
    "    # Standardize\n",
    "    scaler = StandardScaler()\n",
    "    cox_data[top_sensors] = scaler.fit_transform(cox_data[top_sensors])\n",
    "    \n",
    "    try:\n",
    "        cph = CoxPHFitter()\n",
    "        cph.fit(cox_data, duration_col='duration', event_col='event_observed')\n",
    "        \n",
    "        print(\"\\nCox Model Results:\")\n",
    "        print(cph.summary)\n",
    "        print(f\"\\nConcordance Index: {cph.concordance_index_:.4f}\")\n",
    "        \n",
    "        return cph\n",
    "    except Exception as e:\n",
    "        print(f\"Cox model failed: {e}\")\n",
    "        return None\n",
    "\n",
    "# Weibull AFT Model\n",
    "def fit_weibull_model():\n",
    "    if not LIFELINES_AVAILABLE or not sensor_cols:\n",
    "        print(\"Weibull model not available\")\n",
    "        return None\n",
    "    \n",
    "    print(\"\\n\" + \"=\" * 50)\n",
    "    print(\"WEIBULL AFT MODEL\")\n",
    "    print(\"=\" * 50)\n",
    "    \n",
    "    # Select top sensors\n",
    "    correlations = df_survival[sensor_cols].corrwith(df_survival['duration']).abs()\n",
    "    top_sensors = correlations.nlargest(min(2, len(sensor_cols))).index.tolist()\n",
    "    \n",
    "    # Prepare data\n",
    "    weibull_data = df_survival[top_sensors + ['duration', 'event_observed']].copy().dropna()\n",
    "    weibull_data['duration'] = weibull_data['duration'].clip(lower=1e-3)\n",
    "    \n",
    "    # Standardize\n",
    "    scaler = StandardScaler()\n",
    "    weibull_data[top_sensors] = scaler.fit_transform(weibull_data[top_sensors])\n",
    "    \n",
    "    try:\n",
    "        wf = WeibullAFTFitter()\n",
    "        wf.fit(weibull_data, duration_col='duration', event_col='event_observed')\n",
    "        \n",
    "        print(\"\\nWeibull AFT Results:\")\n",
    "        print(wf.summary)\n",
    "        print(f\"\\nConcordance Index: {wf.concordance_index_:.4f}\")\n",
    "        \n",
    "        return wf\n",
    "    except Exception as e:\n",
    "        print(f\"Weibull model failed: {e}\")\n",
    "        return None\n",
    "\n",
    "# Fit models\n",
    "cox_model = fit_cox_model()\n",
    "weibull_model = fit_weibull_model()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Random Forest Baseline\n",
    "print(\"=\" * 50)\n",
    "print(\"RANDOM FOREST BASELINE\")\n",
    "print(\"=\" * 50)\n",
    "\n",
    "if sensor_cols:\n",
    "    # Prepare data\n",
    "    rf_data = df_survival[sensor_cols + ['duration']].copy().dropna()\n",
    "    \n",
    "    # Train/test split\n",
    "    split_idx = int(0.8 * len(rf_data))\n",
    "    train_data = rf_data.iloc[:split_idx]\n",
    "    test_data = rf_data.iloc[split_idx:]\n",
    "    \n",
    "    X_train, y_train = train_data[sensor_cols], train_data['duration']\n",
    "    X_test, y_test = test_data[sensor_cols], test_data['duration']\n",
    "    \n",
    "    # Fit Random Forest\n",
    "    rf = RandomForestRegressor(n_estimators=100, random_state=42)\n",
    "    rf.fit(X_train, y_train)\n",
    "    \n",
    "    # Predictions and metrics\n",
    "    y_pred = rf.predict(X_test)\n",
    "    rmse = np.sqrt(mean_squared_error(y_test, y_pred))\n",
    "    mae = mean_absolute_error(y_test, y_pred)\n",
    "    r2 = rf.score(X_test, y_test)\n",
    "    \n",
    "    print(f\"\\nRandom Forest Performance:\")\n",
    "    print(f\"RMSE: {rmse:.2f}\")\n",
    "    print(f\"MAE: {mae:.2f}\")\n",
    "    print(f\"R²: {r2:.4f}\")\n",
    "    \n",
    "    # Feature importance\n",
    "    importance_df = pd.DataFrame({\n",
    "        'feature': sensor_cols,\n",
    "        'importance': rf.feature_importances_\n",
    "    }).sort_values('importance', ascending=False)\n",
    "    \n",
    "    print(f\"\\nTop Feature Importances:\")\n",
    "    print(importance_df.head())\n",
    "    \n",
    "    # Visualization\n",
    "    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(15, 6))\n",
    "    \n",
    "    # Actual vs Predicted\n",
    "    ax1.scatter(y_test, y_pred, alpha=0.6)\n",
    "    ax1.plot([y_test.min(), y_test.max()], [y_test.min(), y_test.max()], 'r--')\n",
    "    ax1.set_xlabel('Actual Duration')\n",
    "    ax1.set_ylabel('Predicted Duration')\n",
    "    ax1.set_title(f'Random Forest: Actual vs Predicted\\nRMSE: {rmse:.2f}')\n",
    "    \n",
    "    # Feature importance\n",
    "    top_features = importance_df.head(min(10, len(importance_df)))\n",
    "    ax2.barh(range(len(top_features)), top_features['importance'])\n",
    "    ax2.set_yticks(range(len(top_features)))\n",
    "    ax2.set_yticklabels(top_features['feature'])\n",
    "    ax2.set_xlabel('Feature Importance')\n",
    "    ax2.set_title('Feature Importance')\n",
    "    \n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "    \n",
    "else:\n",
    "    print(\"No sensor features available for Random Forest\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Model Comparison and Summary\n",
    "print(\"\\n\" + \"=\" * 60)\n",
    "print(\"MODEL COMPARISON SUMMARY\")\n",
    "print(\"=\" * 60)\n",
    "\n",
    "results = []\n",
    "\n",
    "if cox_model:\n",
    "    results.append(('Cox PH', cox_model.concordance_index_, 'Concordance'))\n",
    "\n",
    "if weibull_model:\n",
    "    results.append(('Weibull AFT', weibull_model.concordance_index_, 'Concordance'))\n",
    "\n",
    "if 'r2' in locals():\n",
    "    results.append(('Random Forest', r2, 'R²'))\n",
    "\n",
    "if results:\n",
    "    results_df = pd.DataFrame(results, columns=['Model', 'Score', 'Metric'])\n",
    "    print(\"\\nModel Performance:\")\n",
    "    print(results_df)\n",
    "    \n",
    "    # Best model\n",
    "    best_idx = results_df['Score'].idxmax()\n",
    "    best_model = results_df.loc[best_idx, 'Model']\n",
    "    best_score = results_df.loc[best_idx, 'Score']\n",
    "    print(f\"\\n🏆 Best Model: {best_model} (Score: {best_score:.4f})\")\n",
    "else:\n",
    "    print(\"No models successfully fitted\")\n",
    "\n",
    "print(f\"\\n💡 Key Insights:\")\n",
    "print(f\"   - Dataset: {data_source} with {len(df_survival)} units\")\n",
    "print(f\"   - Sensor features: {len(sensor_cols)}\")\n",
    "print(f\"   - Survival analysis provides probabilistic failure predictions\")\n",
    "print(f\"   - Models can be used for predictive maintenance scheduling\")\n",
    "\n",
    "if sensor_cols:\n",
    "    print(f\"\\n📊 Top Predictive Sensors:\")\n",
    "    if 'importance_df' in locals():\n",
    "        for _, row in importance_df.head(3).iterrows():\n",
    "            print(f\"   - {row['feature']}: {row['importance']:.4f}\")\n",
    "\n",
    "print(f\"\\n🔧 Recommendations:\")\n",
    "print(f\"   - Monitor top predictive sensors closely\")\n",
    "print(f\"   - Set maintenance thresholds based on survival probabilities\")\n",
    "print(f\"   - Consider ensemble methods for improved predictions\")\n",
    "print(f\"   - Validate models on new data before deployment\")"
   ]
  }
 ],
